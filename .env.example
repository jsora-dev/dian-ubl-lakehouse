# =============================================================================
# dian-ubl-lakehouse — Ejemplo de Variables de Entorno (SIN SECRETOS REALES)
# Copia este archivo a `.env` para ejecución local: cp .env.example .env
# =============================================================================

# Token opcional de aplicación Socrata (datos.gov.co) para ampliar rate limits en consulta de TRM
SOCRATA_APP_TOKEN=your_optional_token_here

# Ruta local del archivo de base de datos analítica DuckDB
DUCKDB_PATH=data/processed/lakehouse.duckdb

# Nivel de detalle de logs de aplicación (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
